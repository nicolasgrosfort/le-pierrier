{
  "name": "le-pierrier",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "dev:client": "next dev",
    "dev:server": "nodemon",
    "dev:all": "yarn && concurrently \"yarn dev:server\" \"yarn dev:client\"",
    "build:client": "next build",
    "build:server": "yarn && yarn tsup src/server/server.ts --format esm --target es2022 --out-dir dist/server",
    "build:all": "yarn && yarn build:client && yarn build:server",
    "prod:start": "NODE_ENV=production node dist/server/server.js",
    "init:env": "cp exemple.env .env || true",
    "init:db": "mkdir -p db && cp -r exemple.db/ db/ || true"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.1",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jotai": "^2.16.2",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.29.0",
    "next": "16.1.4",
    "nodemon": "^3.1.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
