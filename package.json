{
  "name": "le-pierrier",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "dev:client": "next dev",
    "dev:server": "nodemon",
    "dev:all": "yarn && concurrently \"yarn dev:server\" \"yarn dev:client\"",
    "build:client": "next build",
    "build:server": "yarn && yarn tsup src/server/server.ts --format esm --target es2022 --out-dir dist/server",
    "build:all": "yarn && yarn build:client && yarn build:server",
    "prod:start": "NODE_ENV=production node dist/server/server.js",
    "init:env": "cp exemple.env .env || true",
    "init:db": "mkdir -p db && cp -r exemple.db/ db/ || true"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jotai": "^2.20.2",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "nodemon": "^3.1.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
